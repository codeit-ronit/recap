# RECAP runs fully offline by default. Nothing in this file is required.
# RECAP does not load .env files: export a variable in your shell to change a default,
# e.g.  export RECAP_TOOL_LATENCY_MS=0
# Never put a real key in this file or anywhere in the repository.

# Which decision provider to use (configs/providers.yaml):
#   deterministic -> scripted baseline policy (NOT an LLM), free, the default
#   ollama        -> a real local model via Ollama (qwen3:8b; install it yourself), free
#   groq          -> a real hosted model on Groq's FREE plan (opt-in; see below), free
#   replay        -> replays a recorded real-model run offline, free
#   anthropic     -> PAID Claude API: disabled for this $0 project
RECAP_PROVIDER=deterministic

# --- groq (free hosted plan) --------------------------------------------------------------
# Every live request needs ALL of these; otherwise RECAP refuses before sending anything.
# GROQ_API_KEY=                               # your own key, exported in your shell only
# RECAP_GROQ_FREE_PLAN_CONFIRMED_ON=           # YYYY-MM-DD you checked console Billing: Free plan, no card (max 7 days old)
# RECAP_ALLOW_LIVE_FREE_INFERENCE=1            # per process, for live runs only; never in CI

# --- replay --------------------------------------------------------------------------------
# RECAP_REPLAY_RECORDING=fixtures/recordings/ollama-qwen3-8b-bad-deployment.jsonl

# --- anthropic (PAID; keep it off) ---------------------------------------------------------
# RECAP_ALLOW_PAID_LLM=1                      # the owner's explicit opt-in to a paid API
# ANTHROPIC_API_KEY=

# Where SQLite databases, sandbox state, JSONL traces and model recordings are written.
RECAP_DATA_DIR=data

# Override the simulated tool latency (milliseconds). Empty = use configs/environment.yaml.
RECAP_TOOL_LATENCY_MS=

# Optional features (off by default).
RECAP_ENABLE_EMBEDDINGS=0   # hybrid BM25 + embeddings retrieval, needs `pip install -e ".[embeddings]"`
RECAP_ENABLE_OTEL=0         # also emit OpenTelemetry spans to the console, needs `pip install -e ".[otel]"`
