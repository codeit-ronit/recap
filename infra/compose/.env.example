# Settings for infra/compose/compose.yaml. Every value is optional: the defaults below run the
# offline demo (simulated environment, scripted policy). Copy to infra/compose/.env to change
# any; Docker Compose reads that file, RECAP itself never does. .env is git-ignored.
# Never put a real key or token in this example file.

# Ports on 127.0.0.1 (nothing is published on other interfaces).
RECAP_API_PORT=8000
RECAP_DASHBOARD_PORT=8080
RECAP_PROMETHEUS_PORT=9090

# The operator token for state-changing requests. Empty: generated on first start and saved
# in the data volume (docker compose -f infra/compose/compose.yaml exec api cat /data/operator-token).
RECAP_OPERATOR_TOKEN=
RECAP_OPERATOR_NAME=local-operator

# Decision provider: deterministic (scripted baseline, not an LLM) or replay. Live models are
# not configured in this setup.
RECAP_PROVIDER=deterministic

# The queue and the workers (recap/workers/).
RECAP_QUEUE_CAPACITY=20
RECAP_JOB_MAX_ATTEMPTS=3
RECAP_WORKER_CONCURRENCY=2
RECAP_WORKER_GRACE_SECONDS=25
RECAP_WORKER_HEARTBEAT_SECONDS=5
RECAP_WORKER_HEARTBEAT_TTL_SECONDS=20

# Simulated tool latency in milliseconds (empty: configs/environment.yaml).
RECAP_TOOL_LATENCY_MS=

# GET /metrics for the `metrics` profile's Prometheus: set to 1 together with --profile metrics.
RECAP_METRICS=0
